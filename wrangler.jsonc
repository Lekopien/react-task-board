// Cloudflare Worker (free plan) that serves the showcase site at https://tasks.lekopien.com
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lekopien-tasks",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "routes": [{ "pattern": "tasks.lekopien.com", "custom_domain": true }]
}
